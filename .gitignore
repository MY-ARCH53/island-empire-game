# MCP sunucu yapılandırması — PixelLab API anahtarı gibi gizli bilgiler içerir
.mcp.json

# Godot (godot-game/ = v1 taban, godot-game-v2/ vb. = sonraki sürümler)
godot-game*/.godot/
godot-game*/export_presets.cfg
godot-game*/*.apk
godot-game*/*.aab
godot-game*/*.ipa
# PixelLab ham indirmeleri (kaynak) — üretilen assets/sprites, assets/icons,
# assets/tileset zaten repoda; bunlar tools/generate_*.js için ara kaynak
godot-game*/assets/characters/*/character.zip
godot-game*/assets/characters/*/extracted/
# Not: frontend/public/minigame/ (web export çıktısı) BİLEREK ignore edilmiyor —
# public/game/ gibi statik olarak repoya commit edilip VPS'e öyle deploy ediliyor.
