; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kan Adasi v2"
config/description="Island Empire - Vampire Survivors tarzi mini oyun"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.05, 0.1, 1)
boot_splash/image="res://assets/branding/app_icon.png"
boot_splash/fullsize=false
config/icon="res://assets/branding/app_icon.png"

[autoload]

Upgrades="*res://scripts/autoload/upgrades.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
BackendBridge="*res://scripts/autoload/backend_bridge.gd"
Audio="*res://scripts/autoload/audio_manager.gd"
Effects="*res://scripts/autoload/effects.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation="landscape"

[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
